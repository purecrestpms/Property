# PureCrest Environment Variables
# Port for local Node.js server (defaults to 3000)
PORT=3000

# Optional SQLite database file path for local Node.js runtime (defaults to .data/purecrest.sqlite)
SQLITE_DB_PATH=.data/purecrest.sqlite

# Cloudflare D1 Database binding (configured in wrangler.jsonc for Cloudflare Pages deployment)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
